@page "/emissions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Net
@using System.Security.Claims
@using System.Text.Json
@using Carbon.Front.Util
@using Carbon.Front.ViewModels.Emissions
@using Microsoft.AspNetCore.Components.Authorization
@inject ApiClient Api
@inject SessionStore Session
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<style>
    html, body { margin: 0; padding: 0; background-color: #0f172a; }
</style>

@{
    const string input = "block w-full px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 placeholder-slate-400 text-white focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm";
    const string inputUpper = input + " uppercase";
    const string label = "block text-sm font-medium text-slate-300 mb-1";
}

<div class="min-h-screen bg-slate-900 flex justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-6">
        <div class="bg-slate-800 border border-slate-700 p-8 rounded-xl shadow-2xl space-y-6">
            <div class="flex items-start justify-between">
                <div>
                    <h1 class="text-2xl font-extrabold text-white">Emissões de voo</h1>
                    <p class="mt-1 text-sm text-slate-400">Informe os voos para calcular o CO₂ emitido.</p>
                    <p class="mt-2 text-xs text-slate-400">
                        Perfil: <span class="font-semibold text-indigo-300">@roleName</span> · @RoleDescription
                    </p>
                </div>
                <div class="flex flex-col items-end gap-1">
                    @if (roleName == "Admin")
                    {
                        <a href="/admin/usuarios" class="text-sm text-indigo-400 hover:text-indigo-300">Usuários</a>
                    }
                    <button type="button" @onclick="SignOut" class="text-sm text-slate-400 hover:text-white">Sair</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-900/40 border border-red-500 text-red-300 px-4 py-3 rounded" role="alert">@errorMessage</div>
            }

            <EditForm Model="model" OnValidSubmit="HandleCalculate" class="space-y-6">
                <DataAnnotationsValidator />

                @for (var i = 0; i < model.Flights.Count; i++)
                {
                    var leg = model.Flights[i];
                    var n = i + 1;
                    <fieldset class="border border-slate-600 rounded-lg p-4 space-y-3">
                        <legend class="px-2 text-sm font-medium text-slate-300">Voo @n</legend>
                        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                            <div>
                                <label for="origin-@n" class="@label">Origem</label>
                                <InputText id="@($"origin-{n}")" @bind-Value="leg.Origin" maxlength="3" placeholder="GRU" class="@inputUpper" />
                            </div>
                            <div>
                                <label for="dest-@n" class="@label">Destino</label>
                                <InputText id="@($"dest-{n}")" @bind-Value="leg.Destination" maxlength="3" placeholder="LIS" class="@inputUpper" />
                            </div>
                            <div>
                                <label for="carrier-@n" class="@label">Cia. aérea</label>
                                <InputText id="@($"carrier-{n}")" @bind-Value="leg.CarrierCode" maxlength="2" placeholder="LA" class="@inputUpper" />
                            </div>
                            <div>
                                <label for="number-@n" class="@label">Nº do voo</label>
                                <InputNumber id="@($"number-{n}")" @bind-Value="leg.FlightNumber" class="@input" />
                            </div>
                            <div>
                                <label for="date-@n" class="@label">Data</label>
                                <InputDate id="@($"date-{n}")" @bind-Value="leg.DepartureDate" class="@input" />
                            </div>
                        </div>
                        @if (model.Flights.Count > 1)
                        {
                            <button type="button" @onclick="() => model.Flights.Remove(leg)" class="text-xs text-red-400 hover:text-red-300">Remover voo @n</button>
                        }
                    </fieldset>
                }

                <button type="button" @onclick="() => model.Flights.Add(new())" class="text-sm text-indigo-400 hover:text-indigo-300">+ Adicionar voo</button>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
                    <div>
                        <label for="cabin" class="@label">Classe</label>
                        <InputSelect id="cabin" @bind-Value="model.Cabin" class="@input">
                            <option value="Economy">Econômica</option>
                            <option value="PremiumEconomy">Econômica premium</option>
                            <option value="Business">Executiva</option>
                            <option value="First">Primeira classe</option>
                        </InputSelect>
                    </div>
                    <div>
                        <label for="passengers" class="@label">Passageiros</label>
                        <InputNumber id="passengers" @bind-Value="model.Passengers" class="@input" />
                        <ValidationMessage For="@(() => model.Passengers)" class="text-red-400 text-xs mt-1" />
                    </div>
                    <label class="flex items-center gap-2 text-sm text-slate-300 pb-2">
                        <InputCheckbox @bind-Value="model.RoundTrip" /> Ida e volta
                    </label>
                </div>

                <button type="submit" disabled="@isLoading"
                        class="w-full flex justify-center py-2 px-4 text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-800 focus:ring-indigo-500 disabled:opacity-50">
                    @(isLoading ? "Calculando..." : "Calcular emissão")
                </button>
            </EditForm>
        </div>

        @if (result is not null)
        {
            var pt = CultureInfo.GetCultureInfo("pt-BR");
            <div class="bg-slate-800 border border-slate-700 p-6 rounded-xl space-y-4" role="status">
                <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
                    <p class="text-3xl font-bold text-white">@result.TotalEmissions.TotalKg.ToString("N2", pt) <span class="text-lg font-medium text-slate-300">kg CO₂</span></p>
                    <p class="text-sm text-slate-400">@result.TotalEmissions.TotalTonnes.ToString("N3", pt) t no total</p>
                </div>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    <dt class="text-slate-400">Por passageiro</dt>
                    <dd class="text-white">@result.TotalEmissions.KgPerPassenger.ToString("N2", pt) kg</dd>
                    <dt class="text-slate-400">Nível de impacto</dt>
                    <dd class="text-white">@result.TotalEmissions.Impact.Level</dd>
                    <dt class="text-slate-400">Impacto das trilhas de condensação</dt>
                    <dd class="text-white">@result.TotalEmissions.Impact.ContrailsImpact</dd>
                    <dt class="text-slate-400">Voos / passageiros</dt>
                    <dd class="text-white">@result.Information.FlightsCount / @result.Information.Passengers (@result.Information.Cabin@(result.Information.RoundTrip ? ", ida e volta" : ""))</dd>
                    <dt class="text-slate-400">Calculado em</dt>
                    <dd class="text-white">@result.CalculatedAt.ToLocalTime().ToString("g", pt)</dd>
                </dl>
            </div>
        }
    </div>
</div>

@code {
    private readonly EmissionsModel model = new();
    private EmissionsResponse? result;
    private bool isLoading;
    private string? errorMessage;
    private Guid userId;

    private string claimTypesFound = string.Empty;
    private string roleName = "General";

    private string RoleDescription => roleName switch
    {
        "Admin" => "voos nacionais e internacionais + gestão de usuários",
        "Director" => "voos nacionais e internacionais",
        _ => "apenas voos nacionais"
    };

    // Traduz os erros mais comuns da API
    private static async Task<string> ReadErrorAsync(HttpResponseMessage res)
    {
        var detail = string.Empty;
        try
        {
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("detail", out var d)) detail = d.GetString() ?? string.Empty;
        }
        catch (JsonException) { }

        if (detail.Contains("No emissions data", StringComparison.OrdinalIgnoreCase))
            return "Não há dados de emissão para esses voos. Confira aeroportos, companhia, número do voo e data.";
        if (detail.Contains("airport", StringComparison.OrdinalIgnoreCase))
            return "Aeroporto inválido. Use o código IATA de 3 letras (ex.: GRU).";
        if ((int)res.StatusCode >= 500)
            return "Erro no servidor ao calcular as emissões. Verifique a chave do Travel Impact na API.";
        return string.IsNullOrEmpty(detail) ? "Não foi possível calcular as emissões." : $"Não foi possível calcular: {detail}";
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login?returnUrl=%2Femissions", replace: true);
            return;
        }
        if (!Session.FaceVerified)
        {
            Navigation.NavigateTo("/facial?returnUrl=%2Femissions", replace: true);
            return;
        }
        claimTypesFound = string.Join(", ", user.Claims.Select(c => c.Type));
        userId = FindUserId(user);
        roleName = user.IsInRole("Admin") ? "Admin" : user.IsInRole("Director") ? "Director" : "General";
    }

    private static Guid FindUserId(ClaimsPrincipal user)
    {
        string[] known = [ClaimTypes.NameIdentifier, "sub", "nameid", "userid", "user_id", "uid", "id"];

        // 1) well-known names, case-insensitive
        foreach (var c in user.Claims.Where(c => known.Contains(c.Type, StringComparer.OrdinalIgnoreCase)))
            if (Guid.TryParse(c.Value, out var id)) return id;

        // 2) last resort: any Guid-valued claim except jti (the token's own id)
        foreach (var c in user.Claims.Where(c => c.Type != "jti"))
            if (Guid.TryParse(c.Value, out var id)) return id;

        return Guid.Empty;
    }

    private async Task HandleCalculate()
    {
        errorMessage = ValidateFlights();
        if (errorMessage is not null) return;

        isLoading = true;
        result = null;

        try
        {
            var request = new EmissionsRequest(
                userId,
                model.Flights.Select(f => new Carbon.Front.ViewModels.Emissions.FlightLeg(
                    f.Origin.Trim().ToUpperInvariant(), f.Destination.Trim().ToUpperInvariant(),
                    f.CarrierCode.Trim().ToUpperInvariant(), f.FlightNumber, f.DepartureDate!.Value)).ToList(),
                model.Cabin, model.Passengers, model.RoundTrip);

            using var res = await Api.PostAsync("/Carbon/Emissions/Calculate", request, authorized: true);

            switch (res.StatusCode)
            {
                case HttpStatusCode.Unauthorized:
                    Navigation.NavigateTo("/login?returnUrl=%2Femissions", replace: true);
                    return;
                case HttpStatusCode.Forbidden:
                    errorMessage = $"Seu perfil ({roleName}) só pode calcular voos nacionais. Voos internacionais exigem perfil Director ou Admin.";
                    return;
            }

            if (!res.IsSuccessStatusCode)
            {
                errorMessage = await ReadErrorAsync(res);
                return;
            }

            result = await res.Content.ReadFromJsonAsync<EmissionsResponse>();
        }
        catch (HttpRequestException) { errorMessage = "Não foi possível conectar ao servidor."; }
        catch (JsonException) { errorMessage = "Resposta inesperada do servidor."; }
        finally { isLoading = false; }
    }

    // DataAnnotationsValidator doesn't walk nested list items, so legs are checked here.
    private string? ValidateFlights()
    {
        for (var i = 0; i < model.Flights.Count; i++)
        {
            var f = model.Flights[i];
            var n = i + 1;
            if (!IsLetters(f.Origin, 3)) return $"Voo {n}: a origem deve ter 3 letras (código IATA).";
            if (!IsLetters(f.Destination, 3)) return $"Voo {n}: o destino deve ter 3 letras (código IATA).";
            if (f.CarrierCode?.Trim().Length != 2) return $"Voo {n}: a companhia aérea deve ter 2 caracteres.";
            if (f.FlightNumber is < 1 or > 9999) return $"Voo {n}: o número do voo deve estar entre 1 e 9999.";
            if (f.DepartureDate is null) return $"Voo {n}: informe a data de partida.";
        }
        return null;
    }

    private static bool IsLetters(string? s, int len) => s?.Trim() is { } t && t.Length == len && t.All(char.IsLetter);

    private async Task SignOut()
    {
        await Session.ClearAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    public class FlightLegModel
    {
        public string Origin { get; set; } = string.Empty;
        public string Destination { get; set; } = string.Empty;
        public string CarrierCode { get; set; } = string.Empty;
        public int FlightNumber { get; set; }
        public DateOnly? DepartureDate { get; set; }
    }

    public class EmissionsModel
    {
        public List<FlightLegModel> Flights { get; set; } = new() { new() };
        public string Cabin { get; set; } = "Economy";

        [Range(1, 100, ErrorMessage = "Passageiros deve ser entre 1 e 100.")]
        public int Passengers { get; set; } = 1;

        public bool RoundTrip { get; set; }
    }
}
